{
  "name": "@gly-juca/juca-jsx",
  "version": "0.0.6",
  "type": "module",
  "description": "JSX UI Components for apps",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gly-engine/juca-jsx.git"
  },
  "bugs": "https://github.com/gly-engine/juca-jsx/issues",
  "scripts": {
    "prebuild:index": "npm run build",
    "prebuild:sample": "npm run build",
    "build": "tstl --declaration",
    "build:index": "gly-cli build-ginga --enterprise --target ncl --cwd dist src/index.lua --bundler --outdir build/dist --non-relative && cp -r assets build/dist/",
    "postbuild": "cp README.md package.json tsconfig.json .npmignore dist",
    "build:sample": "gly-cli build-html --screen 1920x1080 --cwd dist src/page.lua --outdir build/dist",
    "lint:fix": "eslint . --fix",
    "lint": "eslint .",
    "format:fix": "prettier --write .",
    "format": "prettier --check ."
  },
  "dependencies": {
    "@typescript-to-lua/language-extensions": "^1.19.0",
    "@gamely/tstl-import": "0.0.3"
  },
  "devDependencies": {
    "@gamely/acai-jsx": "github:gly-engine/acai-jsx#7b50b6351ce720c25a9407a47b6f0e4e5dffba74",
    "@gamely/gly-cli": "github:gly-engine/gly-engine#893565fb7e6ff971b6c71ec5ab2c459b54d9abb3",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.33.0",
    "typescript-eslint": "^8.39.1",
    "fengari": "github:fengari-lua/fengari#6a8908380a9b5fc3a8f0fe1e9c1b79ce5dba9312",
    "typescript-to-lua": "^1.36.0",
    "prettier": "^3.6.2"
  }
}
